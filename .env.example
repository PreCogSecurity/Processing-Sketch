# Environment configuration for Processing-Sketch.
#
# Copy this file to .env and fill in real values, then export them into the
# environment before running a sketch. .env is git-ignored; this template is not
# and must never contain a real credential.
#
#   cp .env.example .env
#
# Nothing in this repository reads .env automatically. Processing has no dotenv
# support; set the variables in your shell or OS before launching the sketch.
#
#   PowerShell:
#     Get-Content .env | Where-Object { $_ -match '=' } | ForEach-Object {
#       $n, $v = $_ -split '=', 2
#       [Environment]::SetEnvironmentVariable($n.Trim(), $v.Trim(), 'User')
#     }
#
#   bash / zsh:
#     set -a; . ./.env; set +a

# ---------------------------------------------------------------------------
# CustomSearchJSON sketch (Google Custom Search JSON API)
# ---------------------------------------------------------------------------
# API key with the Custom Search API enabled, from the Google Cloud console.
# Restrict it: API restriction to "Custom Search API", and application
# restriction to your own IP ranges where possible.
GOOGLE_CUSTOM_SEARCH_API_KEY=

# Custom Search engine ID, shown as cx=... in the search engine's configuration
# screen. This is an identifier, not a secret, but it is still account-specific
# so it is read from the environment rather than committed.
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# ---------------------------------------------------------------------------
# GraphArduino sketch
# ---------------------------------------------------------------------------
# Serial device to open, for example COM3 on Windows or /dev/ttyUSB0 on Linux.
# Leave blank to use the first device found. An empty value is handled: the
# sketch reports that no device was found instead of crashing.
ARDUINO_PORT=